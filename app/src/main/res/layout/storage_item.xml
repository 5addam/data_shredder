<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp"
    app:cardCornerRadius="2dp"
    app:cardElevation="5dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/storage_item_icon"
            android:layout_width="75dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:padding="5dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_folder_filled"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"/>

        <TextView
            android:id="@+id/storage_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/average_sans"
            android:maxLines="1"
            android:text="Movies"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/txt_sl"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/isChecked"
            app:layout_constraintTop_toTopOf="parent"
            android:textAlignment="viewStart"
            app:layout_constraintStart_toEndOf="@id/storage_item_icon"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/storage_item_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/average_sans"
            android:text="1.5 Gb"
            android:textColor="@color/grey"
            android:textSize="@dimen/txt_sm"
            app:layout_constraintTop_toBottomOf="@id/storage_item_name"
            app:layout_constraintStart_toStartOf="@id/storage_item_name"/>


        <CheckBox
            android:id="@+id/isChecked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="5dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>